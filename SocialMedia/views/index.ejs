<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body class="bg-light">

    <nav class="navbar fixed-top shadow-sm" style="background-color: lightblue;">
        <div class="container">

            <!-- Left side -->
            <a href="/" class="navbar-brand fw-bold">
                Quora
            </a>

            <!-- Right side -->
            <div>
                <a href="/login" class="btn btn-outline-dark me-2">
                    Login
                </a>

                <a href="/signup" class="btn btn-dark">
                    Signup
                </a>
            </div>

        </div>
    </nav>

    <div class="container mt-5" style="padding-top: 20px;">


    <div class="container mt-5">

        <h1 class="text-center mb-5" style="text-decoration: underline;">
            Quora Posts
        </h1>

        <div class="row g-4">

            <% for(post of posts){ %>

                <div class="col-md-4">

                    <div class="card h-100 shadow-sm post">

                        <div class="card-body">

                            <h5 class="card-title" style="color:#8a327a !important; font-style:italic;">
                                @<%= post.username %>
                            </h5>

                            <p class="card-text content">
                                <%= post.content %>
                            </p>

                            <div class="d-flex gap-2 mt-3">

                                <a href="http://localhost:8080/posts/<%= post.id %>" class="post-btn">
                                    View Post in Details
                                </a>

                                <a href="http://localhost:8080/posts/<%= post.id %>/edit" class="edit-btn">
                                    Edit Post
                                </a>

                                <form method="post" action="/posts/<%=post.id%>?_method=DELETE">
                                    <button class="delete-btn">
                                        Delete Post
                                    </button>
                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            <% } %>

            <br />
            <br />

            <div class="text-start mt-4">
                <a href="http://localhost:8080/posts/new" class="create-btn">
                    Create New Post
                </a>
            </div>

        </div>

    </div>

</body>

</html>
