<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Create New Post</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">
<div class="row justify-content-center">
<div class="col-md-6">
<div class="card shadow border-0" style="background-color:#eef6ff">
<div class="card-body">
<h2 class="text-center mb-4">Create New Post</h2>
<form method="post" action="/posts">
<input class="form-control mb-3" placeholder="Enter Username" name="username">
<textarea class="form-control mb-3" placeholder="Write Your Post" name="content" rows="5"></textarea>
<button class="btn btn-primary w-100">Submit Post</button>
</form>
</div>
</div>
</div>
</div>
</div>

</body>
</html>