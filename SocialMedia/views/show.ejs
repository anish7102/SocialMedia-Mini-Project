    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">
                <div class="card shadow border-0" style="background-color:#f3e8ff;">
                    <div class="card-body p-4">

                        <h2 class="text-center mb-4">Here is your post in detail</h2>

                        <div class="bg-white p-3 rounded mb-3">
                            <h5>Post ID</h5>
                            <p class="mb-0">
                                <%=post.id%>
                            </p>
                        </div>

                        <div class="bg-white p-3 rounded mb-3">
                            <h5>Username</h5>
                            <p class="mb-0">@<%=post.username%>
                            </p>
                        </div>

                        <div class="bg-white p-3 rounded">
                            <h5>Post Content</h5>
                            <p class="mb-0">
                                <%=post.content%>
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

